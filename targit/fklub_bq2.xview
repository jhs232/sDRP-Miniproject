			<metadata database="FKlub" cube="F-Klub Sales"/>
			<onDbInaccessible isrequired="false" autoremove="false"/>
			<fieldUsage openwithoutdata="false" onlynonempty="default">
				<x>
					<metadata dimension="Member" hierarchy="Gender"/>
					<dynamiccaptionformat level="Gender">
						<total>{"Text":"{cellvalue}"}</total>
					</dynamiccaptionformat>
				</x>
				<y>
					<metadata dimension="Product" hierarchy="Product Classification" level="Category"/>
				</y>
				<expand>{"X":[{"LevelId":{"Database":"FKlub","Cube":"F-Klub Sales","Dimension":"Member","Hierarchy":"Gender"},"CollapseMembers":null,"ExpandMembers":null}],"Y":[{"LevelId":{"Database":"FKlub","Cube":"F-Klub Sales","Dimension":"Product","Hierarchy":"Product Classification","Level":"Category"},"CollapseMembers":[],"ExpandMembers":[]}]}</expand>
				<data>
					<metadata measure="Quantity Sold"/>
				</data>
				<ifempty>{"HideObject":false,"UseCustomMessage":false,"Message":{"Text":""},"Font":{"FontFamily":"Segoe UI","FontSize":11,"Bold":"True","Color":"#808080"}}</ifempty>
			</fieldUsage>
			<gridOptions>
				<vertData>false</vertData>
				<measureCalculations>
					<formula id="CalcMeasA" pintostart="false">
						<title>{"Text":"Share of Purchases"}</title>
						<expression>
if count(0, 0, @"Quantity Sold") = 0
or sum(0, all, @"Quantity Sold") = 0
then 0
else sum(0, 0, @"Quantity Sold") / sum(0, all, @"Quantity Sold")
</expression>
						<color>FF74CFD7</color>
						<format astime="false" abbreviatebmk="false">Percent</format>
						<dynamiclabelformat>{"Text":" "}</dynamiclabelformat>
						<label visible="true" measure="false" dimension="false" percent="false" value="false" total="false"/>
					</formula>
