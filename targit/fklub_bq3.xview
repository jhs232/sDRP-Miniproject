		<object typeName="Crosstab" chartclass="" ID="{8C112EE5-610B-4C3E-8E2E-4434FE72DF9C}" name="Crosstab5">
			<version suite="26.10.5006" dataobj="21" criteria="3"/>
			<metadata database="FKlub" cube="F-Klub Sales Analysis"/>
			<onDbInaccessible isrequired="false" autoremove="false"/>
			<fieldUsage openwithoutdata="false" onlynonempty="default">
				<x hideTotal="true">
					<metadata dimension="Date" hierarchy="Calendar" level="Month"/>
					<hideLevel name="Year" labels="true" subtotals="true" values="true"/>
				</x>
				<y>
					<metadata dimension="Product" hierarchy="Product Classification" level="Product"/>
				</y>
				<expand>{"X":[{"LevelId":{"Database":"FKlub","Cube":"F-Klub Sales Analysis","Dimension":"Date","Hierarchy":"Calendar","Level":"Month"},"CollapseMembers":[],"ExpandMembers":[]}],"Y":[{"LevelId":{"Database":"FKlub","Cube":"F-Klub Sales Analysis","Dimension":"Product","Hierarchy":"Product Classification","Level":"Product"},"CollapseMembers":[{"Key":"[Category].&amp;[Arrangementer]","Name":["Arrangementer"]},{"Key":"[Category].&amp;[Drikkevarer]","Name":["Drikkevarer"]},{"Key":"[Category].&amp;[Mad]","Name":["Mad"]},{"Key":"[Category].&amp;[Øvrigt]","Name":["Øvrigt"]}],"ExpandMembers":[]}]}</expand>
				<data>
					<metadata measure="Quantity Sold"/>
				</data>
				<data>
					<metadata measure="Calendar Days"/>
				</data>
				<ifempty>{"HideObject":false,"UseCustomMessage":false,"Message":{"Text":""},"Font":{"FontFamily":"Segoe UI","FontSize":11,"Bold":"True","Color":"#808080"}}</ifempty>
			</fieldUsage>
			<gridOptions>
				<vertData>false</vertData>
				<measureCalculations>
					<formula id="CalcMeasA" pintostart="false">
						<title>{"Text":"Items/day"}</title>
						<expression>if count(0, 0, @"Quantity Sold") = 0
or count(0, 0, @"Calendar Days") = 0
or sum(0, 0, @"Calendar Days") = 0
then 0
else sum(0, 0, @"Quantity Sold") / sum(0, 0, @"Calendar Days")</expression>
						<color>FF74CFD7</color>
						<customsize sizepx="105"/>
						<format astime="false" abbreviatebmk="false">#,##0.00</format>
						<label visible="true" measure="false" dimension="false" percent="false" value="false" total="false"/>
					</formula>
				</measureCalculations>
				<sort collate="true"/>
				<hierarchyDisplay>standard</hierarchyDisplay>
				<wordwrap global="true"/>
				<autodetecturl enabled="true"/>
				<agentList>
					<agent type="measure" ref="0(l0)" dataref="m3" action="cellbackgroundcolor" entirerow="false" hidetext="false" color="FF2563A6">
						<title>{"Text":"High"}</title>
						<condition>value &gt; avg(all, 0, 0) + stdev(all, 0, 0)</condition>
					</agent>
					<agent type="measure" ref="0(l0)" dataref="m3" action="cellbackgroundcolor" entirerow="false" hidetext="false" color="FFA9D5ED">
						<title>{"Text":"Middle"}</title>
						<condition>(value &lt;= avg(all, 0, 0) + stdev(all, 0, 0)) and
(value &gt;= avg(all, 0, 0) - stdev(all, 0, 0))</condition>
					</agent>
					<agent type="measure" ref="0(l0)" dataref="m3" action="cellbackgroundcolor" entirerow="false" hidetext="false" color="FFEAF4FA">
						<title>{"Text":"Low"}</title>
						<condition>value &lt; avg(all, 0, 0) - stdev(all, 0, 0)</condition>
					</agent>
				</agentList>
				<totals grandtotals="true" subtotals="true" highlightX="true" highlightY="true"/>
				<measureproperties idx="0">
					<hidden>true</hidden>
					<label visible="true" measure="true" dimension="true" percent="false" value="true" total="false"/>
				</measureproperties>
				<measureproperties idx="1">
