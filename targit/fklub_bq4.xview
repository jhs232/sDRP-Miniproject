				<agentList>
					<agent type="measure" ref="0(l0)" dataref="m2" action="cellbackgroundcolor" entirerow="false" hidetext="false" color="FF286DA5">
						<title>{"Text":"High"}</title>
						<condition>value &gt; avg(all, 0, 0) + stdev(all, 0, 0)</condition>
					</agent>
					<agent type="measure" ref="0(l0)" dataref="m2" action="cellbackgroundcolor" entirerow="false" hidetext="false" color="FF91BDDC">
						<title>{"Text":"Middle"}</title>
						<condition>(value &lt;= avg(all, 0, 0) + stdev(all, 0, 0))
and
(value &gt;= avg(all, 0, 0) - stdev(all, 0, 0))</condition>
					</agent>
					<agent type="measure" ref="0(l0)" dataref="m2" action="cellbackgroundcolor" entirerow="false" hidetext="false" color="FFDCECF7">
						<title>{"Text":"Low"}</title>
						<condition>value &lt; avg(all, 0, 0) - stdev(all, 0, 0)</condition>
					</agent>
				</agentList>
